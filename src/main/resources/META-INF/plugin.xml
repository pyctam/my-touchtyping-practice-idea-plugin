<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.pyctam.touchtypingpractice</id>
    <name>Touch Typing Practice</name>
    <vendor email="my-touchtyping-practice-idea-plugin@4-4.org">my-touchtyping-practice-idea-plugin</vendor>
    <description>A tool window for practicing touch typing directly in IntelliJ IDEA with configurable practice modes, finger selection, and real-time error tracking.</description>
    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.UI</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow anchor="right"
                    factoryClass="com.github.pyctam.touchtypingpractice.toolWindow.TouchTypingToolWindowFactory"
                    id="Touch Typing Practice"
                    secondary="false"/>
        <projectConfigurable instance="com.github.pyctam.touchtypingpractice.config.Configuration"
                             displayName="Touch Typing Practice"
                             id="com.github.pyctam.touchtypingpractice.config.Configuration"/>
    </extensions>

    <actions>
        <action id="com.github.pyctam.touchtypingpractice.toolWindow.ToggleTouchTypingPracticeAction"
                class="com.github.pyctam.touchtypingpractice.toolWindow.ToggleTouchTypingPracticeAction"
                text="Toggle Touch Typing Practice"
                description="Open or close the Touch Typing Practice tool window">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt P" second-keystroke="P"/>
        </action>
    </actions>
</idea-plugin>
